SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=False
# Add your tunnel hostname here (wildcards for trycloudflare / ngrok are included by default)
ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,.ngrok-free.app,.ngrok.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,https://*.trycloudflare.com,https://*.ngrok-free.app
MESSAGE_TTL_HOURS=24
# Optional: how often the background purge runs (seconds)
PURGE_INTERVAL_SECONDS=3600
