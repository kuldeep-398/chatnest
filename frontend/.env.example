# Leave empty to use the same origin the page is served from (recommended:
# Django serves the built app, so one tunnel URL serves UI + API + WebSockets).
# Set these only if the API lives on a different host than the frontend.
VITE_API_URL=
VITE_WS_URL=
# Example for split hosting:
# VITE_API_URL=https://my-tunnel.trycloudflare.com
# VITE_WS_URL=wss://my-tunnel.trycloudflare.com
